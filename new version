<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VertexTW — Hall Effect Gaming Keyboards</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet">
<style>
:root {
  --green: #00e5a0;
  --green-dim: rgba(0,229,160,0.12);
  --green-glow: rgba(0,229,160,0.22);
  --bg: #060810;
  --surface: #0d1018;
  --surface2: #131720;
  --border: rgba(255,255,255,0.07);
  --border-hover: rgba(0,229,160,0.35);
  --text: #e8edf5;
  --muted: #7a8496;
  --danger: #ff4f4f;
}
* { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior: smooth; }
body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--text); overflow-x: hidden; min-height: 100vh; }

.page { display: none; min-height: 100vh; }
.page.active { display: block; }

/* NAV */
nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 900;
  background: rgba(6,8,16,0.85); backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--border);
  padding: 0 5%; height: 64px;
  display: flex; align-items: center; justify-content: space-between;
}
.logo { font-family: 'Syne', sans-serif; font-size: 1.5rem; font-weight: 800; color: var(--text); cursor: pointer; }
.logo span { color: var(--green); }
.nav-links { display: flex; align-items: center; gap: 32px; list-style: none; }
.nav-links a { font-size: 0.9rem; color: var(--muted); text-decoration: none; transition: color 0.2s; cursor: pointer; }
.nav-links a:hover { color: var(--green); }
.nav-right { display: flex; align-items: center; gap: 12px; }

/* LANGUAGE SELECTOR */
.lang-wrap { position: relative; }
.lang-btn {
  display: flex; align-items: center; gap: 7px;
  background: var(--surface2); border: 1px solid var(--border);
  color: var(--muted); padding: 7px 13px;
  border-radius: 50px; cursor: pointer;
  font-family: 'DM Sans', sans-serif; font-size: 0.82rem; font-weight: 500;
  transition: all 0.2s;
}
.lang-btn:hover { border-color: var(--border-hover); color: var(--text); }
.lang-btn .chevron { font-size: 0.55rem; opacity: 0.6; transition: transform 0.2s; }
.lang-wrap.open .lang-btn .chevron { transform: rotate(180deg); }

.lang-dropdown {
  position: absolute; top: calc(100% + 8px); right: 0;
  background: var(--surface); border: 1px solid var(--border);
  border-radius: 14px; min-width: 190px; overflow: hidden;
  opacity: 0; pointer-events: none;
  transform: translateY(-6px); transition: all 0.2s; z-index: 999;
  box-shadow: 0 20px 48px rgba(0,0,0,0.5);
}
.lang-wrap.open .lang-dropdown { opacity: 1; pointer-events: auto; transform: translateY(0); }
.lang-option {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 16px; cursor: pointer;
  font-size: 0.875rem; color: var(--muted); transition: all 0.15s;
}
.lang-option:hover { background: var(--surface2); color: var(--text); }
.lang-option.active { color: var(--green); font-weight: 500; }
.lang-option .flag { font-size: 1.1rem; }
.lang-option .lang-name { flex: 1; }
.lang-option .check { font-size: 0.75rem; color: var(--green); opacity: 0; }
.lang-option.active .check { opacity: 1; }

.cart-btn-nav {
  background: var(--green-dim); border: 1px solid var(--border-hover); color: var(--green);
  padding: 8px 18px; border-radius: 50px; cursor: pointer;
  font-family: 'DM Sans', sans-serif; font-size: 0.88rem; font-weight: 500;
  display: flex; align-items: center; gap: 8px; transition: all 0.2s;
}
.cart-btn-nav:hover { background: rgba(0,229,160,0.2); transform: translateY(-1px); }
.cart-count { background: var(--green); color: var(--bg); width: 20px; height: 20px; border-radius: 50%; font-size: 0.72rem; font-weight: 700; display: flex; align-items: center; justify-content: center; }

/* HERO */
.hero { min-height: 100vh; display: flex; flex-direction: column; padding-top: 64px; position: relative; overflow: hidden; }
.hero-bg { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
.hero-bg::before { content: ''; position: absolute; width: 800px; height: 800px; border-radius: 50%; background: radial-gradient(circle, rgba(0,229,160,0.08) 0%, transparent 70%); top: -200px; right: -200px; animation: pulse 8s ease-in-out infinite; }
.hero-bg::after { content: ''; position: absolute; width: 600px; height: 600px; border-radius: 50%; background: radial-gradient(circle, rgba(70,100,255,0.06) 0%, transparent 70%); bottom: -100px; left: -100px; animation: pulse 10s ease-in-out infinite 2s; }
@keyframes pulse { 0%,100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.1); opacity: 0.7; } }

.slideshow { position: relative; z-index: 1; flex: 1; display: flex; align-items: center; padding: 60px 5%; }
.slides-wrapper { position: relative; width: 100%; min-height: 520px; }
.slide { position: absolute; inset: 0; display: flex; align-items: center; gap: 80px; opacity: 0; transform: translateX(60px); transition: all 0.6s cubic-bezier(0.25,0.46,0.45,0.94); pointer-events: none; }
.slide.active { opacity: 1; transform: translateX(0); pointer-events: auto; }
.slide.exit-left { opacity: 0; transform: translateX(-60px); }
.slide-visual { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: center; }
.keyboard-display { width: 100%; max-width: 500px; height: 300px; border-radius: 20px; border: 1px solid var(--border); background: var(--surface); display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
.keyboard-display::before { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(0,229,160,0.04) 0%, transparent 60%); }
.keyboard-emoji { font-size: 6rem; filter: drop-shadow(0 0 40px rgba(0,229,160,0.3)); animation: float 4s ease-in-out infinite; }
@keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }
.kb-label { position: absolute; bottom: 16px; left: 20px; font-size: 0.75rem; color: var(--muted); letter-spacing: 0.05em; }
.slide-info { flex: 1; min-width: 0; }
.slide-badge { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border-radius: 50px; border: 1px solid var(--border-hover); background: var(--green-dim); color: var(--green); font-size: 0.8rem; font-weight: 500; margin-bottom: 24px; }
.slide-info h1 { font-family: 'Syne', sans-serif; font-size: clamp(2.4rem, 5vw, 4rem); font-weight: 800; line-height: 1.05; margin-bottom: 20px; }
.slide-info h1 em { font-style: normal; color: var(--green); }
.slide-info p { color: var(--muted); font-size: 1.05rem; line-height: 1.8; margin-bottom: 32px; max-width: 420px; }
.slide-price-row { display: flex; align-items: center; gap: 20px; margin-bottom: 32px; }
.slide-price { font-family: 'Syne', sans-serif; font-size: 2.4rem; font-weight: 700; color: var(--green); }
.price-note { font-size: 0.82rem; color: var(--muted); line-height: 1.4; }
.slide-actions { display: flex; gap: 14px; flex-wrap: wrap; }
.btn-primary { background: var(--green); color: var(--bg); border: none; padding: 14px 28px; border-radius: 12px; font-family: 'DM Sans', sans-serif; font-size: 0.95rem; font-weight: 600; cursor: pointer; transition: all 0.25s; display: flex; align-items: center; gap: 8px; }
.btn-primary:hover { transform: translateY(-3px); box-shadow: 0 12px 32px var(--green-glow); }
.btn-ghost { background: var(--surface2); color: var(--text); border: 1px solid var(--border); padding: 14px 28px; border-radius: 12px; font-family: 'DM Sans', sans-serif; font-size: 0.95rem; font-weight: 500; cursor: pointer; transition: all 0.25s; }
.btn-ghost:hover { border-color: var(--border-hover); color: var(--green); }
.slide-controls { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; gap: 16px; padding: 0 5% 50px; }
.dot-btn { width: 10px; height: 10px; border-radius: 50%; background: var(--border); border: none; cursor: pointer; transition: all 0.3s; padding: 0; }
.dot-btn.active { background: var(--green); width: 28px; border-radius: 5px; }
.arrow-btn { background: var(--surface2); border: 1px solid var(--border); color: var(--muted); width: 40px; height: 40px; border-radius: 50%; cursor: pointer; font-size: 1rem; display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
.arrow-btn:hover { border-color: var(--border-hover); color: var(--green); }

/* PRODUCTS */
.products-section { padding: 80px 5%; background: var(--surface); border-top: 1px solid var(--border); }
.section-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 48px; }
.section-header h2 { font-family: 'Syne', sans-serif; font-size: 2.4rem; font-weight: 700; }
.section-header h2 span { color: var(--green); }
.see-all { color: var(--green); font-size: 0.9rem; text-decoration: none; cursor: pointer; display: flex; align-items: center; gap: 6px; transition: gap 0.2s; }
.see-all:hover { gap: 10px; }
.products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; }
.product-card { background: var(--bg); border: 1px solid var(--border); border-radius: 20px; overflow: hidden; cursor: pointer; transition: all 0.35s; position: relative; }
.product-card:hover { transform: translateY(-8px); border-color: var(--border-hover); box-shadow: 0 24px 64px rgba(0,0,0,0.5), 0 0 0 1px var(--border-hover); }
.product-card-img { width: 100%; height: 200px; background: var(--surface2); display: flex; align-items: center; justify-content: center; font-size: 4.5rem; position: relative; overflow: hidden; border-bottom: 1px solid var(--border); }
.product-card-img::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgba(6,8,16,0.3) 100%); }
.product-card-body { padding: 22px; }
.product-card .badge { display: inline-block; padding: 4px 12px; border-radius: 50px; background: var(--green-dim); border: 1px solid var(--border-hover); color: var(--green); font-size: 0.75rem; font-weight: 500; margin-bottom: 12px; }
.product-card h3 { font-family: 'Syne', sans-serif; font-size: 1.35rem; font-weight: 700; margin-bottom: 8px; }
.product-card .desc { color: var(--muted); font-size: 0.88rem; line-height: 1.7; margin-bottom: 18px; }
.product-card-footer { display: flex; align-items: center; justify-content: space-between; }
.product-price { font-family: 'Syne', sans-serif; font-size: 1.6rem; font-weight: 700; color: var(--green); }
.add-cart-mini { background: var(--green-dim); border: 1px solid var(--border-hover); color: var(--green); padding: 8px 16px; border-radius: 10px; font-family: 'DM Sans', sans-serif; font-size: 0.82rem; font-weight: 600; cursor: pointer; transition: all 0.2s; }
.add-cart-mini:hover { background: rgba(0,229,160,0.22); }

/* DETAIL */
.product-detail { padding: 100px 5% 80px; max-width: 1200px; margin: 0 auto; }
.back-link { display: inline-flex; align-items: center; gap: 8px; color: var(--muted); font-size: 0.9rem; cursor: pointer; margin-bottom: 48px; transition: color 0.2s; background: none; border: none; font-family: 'DM Sans', sans-serif; }
.back-link:hover { color: var(--green); }
.detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: start; }
.detail-visual { background: var(--surface); border: 1px solid var(--border); border-radius: 24px; height: 400px; display: flex; align-items: center; justify-content: center; font-size: 8rem; position: sticky; top: 84px; overflow: hidden; }
.detail-visual::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 50% 50%, rgba(0,229,160,0.08), transparent 70%); }
.detail-info .brand { font-size: 0.8rem; color: var(--green); letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 12px; }
.detail-info h1 { font-family: 'Syne', sans-serif; font-size: 3rem; font-weight: 800; margin-bottom: 16px; }
.detail-badges { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 28px; }
.detail-badge { padding: 6px 14px; border-radius: 50px; background: var(--surface2); border: 1px solid var(--border); color: var(--muted); font-size: 0.8rem; }
.detail-desc { color: var(--muted); line-height: 1.9; font-size: 1rem; margin-bottom: 36px; }
.specs-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 36px; }
.spec-item { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px; }
.spec-item .spec-label { font-size: 0.75rem; color: var(--muted); margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.06em; }
.spec-item .spec-val { font-size: 0.95rem; font-weight: 500; }
.detail-price-row { display: flex; align-items: baseline; gap: 16px; margin-bottom: 28px; }
.detail-price { font-family: 'Syne', sans-serif; font-size: 2.8rem; font-weight: 800; color: var(--green); }
.detail-price-note { font-size: 0.85rem; color: var(--muted); }
.color-section { margin-bottom: 28px; }
.color-section label { font-size: 0.85rem; color: var(--muted); display: block; margin-bottom: 10px; }
.color-options { display: flex; gap: 10px; }
.color-swatch { width: 28px; height: 28px; border-radius: 50%; border: 2px solid transparent; cursor: pointer; transition: all 0.2s; }
.color-swatch.selected { border-color: var(--green); box-shadow: 0 0 0 3px var(--green-dim); }
.switch-section { margin-bottom: 32px; }
.switch-section label { font-size: 0.85rem; color: var(--muted); display: block; margin-bottom: 10px; }
.switch-options { display: flex; gap: 10px; flex-wrap: wrap; }
.switch-opt { padding: 8px 18px; border-radius: 10px; border: 1px solid var(--border); background: none; color: var(--muted); font-family: 'DM Sans', sans-serif; font-size: 0.85rem; cursor: pointer; transition: all 0.2s; }
.switch-opt:hover { border-color: var(--border-hover); color: var(--text); }
.switch-opt.selected { border-color: var(--green); background: var(--green-dim); color: var(--green); }
.detail-actions { display: flex; gap: 14px; }
.btn-buy-now { flex: 1; background: var(--green); color: var(--bg); border: none; padding: 16px 0; border-radius: 14px; font-family: 'DM Sans', sans-serif; font-size: 1rem; font-weight: 700; cursor: pointer; transition: all 0.25s; }
.btn-buy-now:hover { transform: translateY(-3px); box-shadow: 0 16px 40px var(--green-glow); }
.btn-add-cart-large { flex: 1; background: var(--surface2); color: var(--text); border: 1px solid var(--border); padding: 16px 0; border-radius: 14px; font-family: 'DM Sans', sans-serif; font-size: 1rem; font-weight: 600; cursor: pointer; transition: all 0.25s; }
.btn-add-cart-large:hover { border-color: var(--border-hover); color: var(--green); }

/* CART */
.cart-overlay { position: fixed; inset: 0; z-index: 1000; background: rgba(0,0,0,0.6); backdrop-filter: blur(4px); opacity: 0; pointer-events: none; transition: opacity 0.3s; }
.cart-overlay.open { opacity: 1; pointer-events: auto; }
.cart-drawer { position: fixed; top: 0; right: 0; bottom: 0; z-index: 1001; width: 420px; max-width: 95vw; background: var(--surface); border-left: 1px solid var(--border); display: flex; flex-direction: column; transform: translateX(100%); transition: transform 0.4s cubic-bezier(0.25,0.46,0.45,0.94); }
.cart-drawer.open { transform: translateX(0); }
.cart-header { display: flex; align-items: center; justify-content: space-between; padding: 24px 24px 20px; border-bottom: 1px solid var(--border); }
.cart-header h2 { font-family: 'Syne', sans-serif; font-size: 1.3rem; font-weight: 700; }
.close-btn { width: 36px; height: 36px; background: var(--surface2); border: 1px solid var(--border); color: var(--muted); border-radius: 50%; cursor: pointer; font-size: 1.1rem; display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
.close-btn:hover { border-color: var(--danger); color: var(--danger); }
.cart-body { flex: 1; overflow-y: auto; padding: 20px 24px; }
.cart-empty { text-align: center; padding: 60px 0; color: var(--muted); }
.cart-empty-icon { font-size: 4rem; margin-bottom: 16px; opacity: 0.5; }
.cart-empty p { font-size: 1rem; }
.cart-item-row { display: flex; align-items: center; gap: 14px; padding: 16px 0; border-bottom: 1px solid var(--border); }
.cart-item-img { width: 60px; height: 60px; background: var(--bg); border: 1px solid var(--border); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; flex-shrink: 0; }
.cart-item-info { flex: 1; min-width: 0; }
.cart-item-name { font-weight: 500; font-size: 0.95rem; margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cart-item-meta { font-size: 0.8rem; color: var(--muted); }
.cart-item-right { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
.qty-control { display: flex; align-items: center; gap: 8px; background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 4px 8px; }
.qty-btn { background: none; border: none; color: var(--muted); cursor: pointer; width: 22px; height: 22px; font-size: 1rem; display: flex; align-items: center; justify-content: center; border-radius: 4px; transition: all 0.15s; }
.qty-btn:hover { background: var(--surface2); color: var(--green); }
.qty-num { font-size: 0.9rem; font-weight: 500; min-width: 16px; text-align: center; }
.cart-item-price { font-family: 'Syne', sans-serif; font-size: 1rem; font-weight: 600; color: var(--green); min-width: 72px; text-align: right; }
.remove-item { background: none; border: none; color: var(--muted); cursor: pointer; font-size: 1rem; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; border-radius: 50%; transition: all 0.15s; }
.remove-item:hover { background: rgba(255,79,79,0.1); color: var(--danger); }
.cart-footer { padding: 20px 24px; border-top: 1px solid var(--border); }
.cart-summary { margin-bottom: 18px; }
.cart-summary-row { display: flex; justify-content: space-between; font-size: 0.9rem; color: var(--muted); margin-bottom: 8px; }
.cart-summary-row.total { font-size: 1.1rem; color: var(--text); font-weight: 600; margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border); }
.cart-summary-row.total .total-amount { font-family: 'Syne', sans-serif; color: var(--green); font-size: 1.3rem; }
.btn-checkout { width: 100%; background: var(--green); color: var(--bg); border: none; padding: 16px; border-radius: 14px; font-family: 'DM Sans', sans-serif; font-size: 1rem; font-weight: 700; cursor: pointer; transition: all 0.25s; margin-bottom: 10px; }
.btn-checkout:hover { transform: translateY(-2px); box-shadow: 0 12px 32px var(--green-glow); }
.btn-checkout:disabled { opacity: 0.4; cursor: not-allowed; transform: none; box-shadow: none; }
.btn-continue { width: 100%; background: none; color: var(--muted); border: none; padding: 10px; font-family: 'DM Sans', sans-serif; font-size: 0.88rem; cursor: pointer; transition: color 0.2s; }
.btn-continue:hover { color: var(--green); }

/* CHECKOUT */
.checkout-page { padding: 100px 5% 80px; max-width: 1100px; margin: 0 auto; }
.checkout-page h1 { font-family: 'Syne', sans-serif; font-size: 2.4rem; font-weight: 800; margin-bottom: 8px; }
.checkout-page .sub { color: var(--muted); font-size: 0.95rem; margin-bottom: 48px; }
.checkout-grid { display: grid; grid-template-columns: 1fr 420px; gap: 40px; align-items: start; }
.steps { display: flex; gap: 0; margin-bottom: 40px; }
.step { display: flex; align-items: center; gap: 10px; font-size: 0.85rem; color: var(--muted); }
.step.active { color: var(--text); }
.step.done { color: var(--green); }
.step-num { width: 28px; height: 28px; border-radius: 50%; background: var(--surface2); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 0.78rem; font-weight: 600; }
.step.active .step-num { background: var(--green); color: var(--bg); border-color: var(--green); }
.step.done .step-num { background: var(--green-dim); color: var(--green); border-color: var(--border-hover); }
.step-line { width: 40px; height: 1px; background: var(--border); margin: 0 4px; }
.step-line.done { background: var(--green); }
.form-section { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 28px; margin-bottom: 20px; }
.form-section h3 { font-family: 'Syne', sans-serif; font-size: 1.1rem; font-weight: 700; margin-bottom: 22px; display: flex; align-items: center; gap: 10px; }
.form-section h3 .icon { width: 32px; height: 32px; border-radius: 8px; background: var(--green-dim); border: 1px solid var(--border-hover); display: flex; align-items: center; justify-content: center; font-size: 0.95rem; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px; }
.form-row.full { grid-template-columns: 1fr; }
.form-group { display: flex; flex-direction: column; gap: 6px; }
.form-group label { font-size: 0.8rem; color: var(--muted); letter-spacing: 0.04em; }
.form-group input, .form-group select { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; color: var(--text); font-family: 'DM Sans', sans-serif; font-size: 0.92rem; outline: none; transition: border-color 0.2s; -webkit-appearance: none; }
.form-group input:focus, .form-group select:focus { border-color: var(--green); box-shadow: 0 0 0 3px var(--green-dim); }
.form-group input::placeholder { color: #3a4050; }
.payment-tabs { display: flex; gap: 10px; margin-bottom: 22px; }
.pay-tab { flex: 1; background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 12px; cursor: pointer; text-align: center; transition: all 0.2s; font-size: 0.85rem; color: var(--muted); font-family: 'DM Sans', sans-serif; }
.pay-tab:hover { border-color: var(--border-hover); color: var(--text); }
.pay-tab.active { border-color: var(--green); background: var(--green-dim); color: var(--green); font-weight: 600; }
.pay-tab-icon { font-size: 1.4rem; margin-bottom: 4px; }
.card-number-wrap { position: relative; }
.card-number-wrap input { padding-right: 50px; letter-spacing: 0.1em; }
.card-brand { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); font-size: 1.2rem; }
.order-summary { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 28px; position: sticky; top: 84px; }
