  { id:0, emoji:'⌨️', name:'Nova HE60',       layout:'60%',  price:4590, colors:['#1a1a1a','#2d3561','#8b5a5a'], colorNames:['Carbon Black','Midnight Blue','Deep Red'] },
  { id:1, emoji:'🎮', name:'Phantom 75HE',    layout:'75%',  price:5290, colors:['#1c0f2b','#0f1e1c','#1a1512'], colorNames:['Midnight Purple','Forest Green','Dark Bronze'] },
  { id:2, emoji:'🏆', name:'Titan HE100',     layout:'100%', price:5990, colors:['#202020','#1a1a20','#1a1510'], colorNames:['Space Gray','Cosmic Black','Desert Sand'] },
  { id:3, emoji:'🌸', name:'Cloud Cream75',   layout:'75%',  price:4890, colors:['#f5ede0','#e8d5c0','#d4c4b0'], colorNames:['Cream White','Ivory','Oat'] },
  { id:4, emoji:'⚡', name:'Strike TKL Pro',  layout:'TKL',  price:4290, colors:['#0a0a0a','#12121a','#0a120a'], colorNames:['Stealth Black','Navy','Forest'] },
  { id:5, emoji:'🎵', name:'Mono Mini60',     layout:'60%',  price:3890, colors:['#1a1a1a','#2a2015','#151a1a'], colorNames:['Matte Black','Warm Brown','Slate'] }
];

/* =========================================================
   STATE
   ========================================================= */
let cart = [];
let currentSlide = 0;
let slideTimer;
let lang = 'zh';

/* =========================================================
   TRANSLATION HELPERS
   ========================================================= */
// Get string from current lang, fall back to zh
function T(key) { return LANGS[lang][key] ?? LANGS.zh[key] ?? key; }

// Interpolate {0} placeholder
function L(key, ...args) {
  let s = T(key);
  args.forEach((a,i) => { s = s.replace('{'+i+'}', a); });
  return s;
}

// Apply all data-t attributes in the DOM
function applyLang() {
  document.querySelectorAll('[data-t]').forEach(el => {
    const k = el.getAttribute('data-t');
    el.innerHTML = T(k);
  });
  // Placeholders
  document.querySelectorAll('[data-ph]').forEach(el => {
    el.placeholder = T(el.getAttribute('data-ph'));
  });
  // Section title requires two parts
  const st = document.getElementById('section-title');
  if (st) st.innerHTML = T('section_heading') + ' <span>' + T('section_heading_accent') + '</span>';
  // Re-render dynamic content
  renderProductsGrid();
  renderCartBody();
  renderPaymentFields(currentPayType);
}

/* =========================================================
   LANGUAGE SELECTOR
   ========================================================= */
function toggleLangMenu() {
  document.getElementById('langWrap').classList.toggle('open');
}

document.addEventListener('click', e => {
  const wrap = document.getElementById('langWrap');
  if (!wrap.contains(e.target)) wrap.classList.remove('open');
});

function setLang(code) {
  lang = code;
  const L = LANGS[code];
  document.getElementById('langFlag').textContent  = L.flag;
  document.getElementById('langLabel').textContent = L.label;
  // Mark active option
  document.querySelectorAll('.lang-option').forEach(el => {
    const onclick = el.getAttribute('onclick') || '';
    el.classList.toggle('active', onclick.includes("'"+code+"'"));
  });
  document.getElementById('langWrap').classList.remove('open');
  applyLang();
}

/* =========================================================
   PRODUCTS GRID
   ========================================================= */
function renderProductsGrid() {
  const grid = document.getElementById('products-grid');
  if (!grid) return;
  grid.innerHTML = products.map(p => {
    const badge = T('p'+p.id+'_badge');
    const desc  = T('p'+p.id+'_desc');
    return `
      <div class="product-card" onclick="showProductDetail(${p.id})">
        <div class="product-card-img">${p.emoji}</div>
        <div class="product-card-body">
          <div class="badge">${badge}</div>
          <h3>${p.name}</h3>
          <p class="desc">${desc.substring(0,80)}…</p>
          <div class="product-card-footer">
            <div class="product-price">NT$${p.price.toLocaleString()}</div>
            <button class="add-cart-mini"
              onclick="event.stopPropagation();addToCart(${p.id});showToast(L('added_to_cart','${p.name}'))">
              ${T('add_to_cart')}
            </button>
          </div>
        </div>
      </div>`;
  }).join('');
}

/* =========================================================
   SLIDESHOW
   ========================================================= */
function goSlide(idx) {
  const slides = document.querySelectorAll('.slide');
  const dots   = document.querySelectorAll('.dot-btn');
  slides[currentSlide].classList.remove('active');
  slides[currentSlide].classList.add('exit-left');
  setTimeout(() => slides[currentSlide].classList.remove('exit-left'), 600);
  currentSlide = idx;
  slides[currentSlide].classList.add('active');
  dots.forEach((d,i) => d.classList.toggle('active', i===idx));
  resetTimer();
}
function nextSlide() { goSlide((currentSlide+1)%4); }
function prevSlide() { goSlide((currentSlide+3)%4); }
function resetTimer() {
  clearInterval(slideTimer);
  slideTimer = setInterval(nextSlide, 5000);
}

/* =========================================================
   PAGES
   ========================================================= */
function showPage(name) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById('page-'+name).classList.add('active');
  window.scrollTo(0,0);
}
function scrollToProducts() {
  showPage('home');
  setTimeout(() => document.getElementById('products').scrollIntoView({behavior:'smooth'}), 50);
}

/* =========================================================
   PRODUCT DETAIL
   ========================================================= */
function showProductDetail(id) {
  const p = products[id];
  document.getElementById('detail-visual').innerHTML =
    `<span style="font-size:7rem;position:relative;z-index:1">${p.emoji}</span>`;
  document.getElementById('detail-name').textContent  = p.name;
  document.getElementById('detail-price').textContent = `NT$${p.price.toLocaleString()}`;
  document.getElementById('detail-desc').textContent  = T('p'+id+'_desc');

  const badge = T('p'+id+'_badge');
  document.getElementById('detail-badges').innerHTML =
    badge.split('·').map(b => `<span class="detail-badge">${b.trim()}</span>`).join('');

  const specs = T('p'+id+'_specs');
  document.getElementById('specs-grid').innerHTML =
    specs.map(s => `<div class="spec-item"><div class="spec-label">${s.l}</div><div class="spec-val">${s.v}</div></div>`).join('');

  document.getElementById('color-options').innerHTML =
    p.colors.map((c,i) =>
      `<div class="color-swatch ${i===0?'selected':''}" style="background:${c}" title="${p.colorNames[i]}"
        onclick="selectColor(this)"></div>`
    ).join('');

  const switches = T('p'+id+'_switches');
  document.getElementById('switch-options').innerHTML =
    switches.map((s,i) =>
      `<button class="switch-opt ${i===0?'selected':''}" onclick="selectOpt(this)">${s}</button>`
    ).join('');

  // Re-translate static labels on detail page
  document.querySelectorAll('#page-detail [data-t]').forEach(el => {
    el.innerHTML = T(el.getAttribute('data-t'));
  });

  document.getElementById('detail-buy-now').onclick = () => {
    addToCart(id); showToast(L('added_to_cart', p.name)); goCheckout();
  };
  document.getElementById('detail-add-cart').onclick = () => {
    addToCart(id); showToast(L('added_to_cart', p.name));
  };

  showPage('detail');
}

function selectColor(el) {
  el.closest('.color-options').querySelectorAll('.color-swatch').forEach(s => s.classList.remove('selected'));
  el.classList.add('selected');
}
function selectOpt(el) {
  el.closest('.switch-options').querySelectorAll('button').forEach(b => b.classList.remove('selected'));
  el.classList.add('selected');
}

/* =========================================================
   CART
   ========================================================= */
function addToCart(productId) {
  const existing = cart.find(i => i.productId === productId);
  if (existing) existing.qty++;
  else cart.push({productId, qty:1});
  updateCartUI();
}
function removeFromCart(productId) {
  cart = cart.filter(i => i.productId !== productId);
  updateCartUI();
}
function changeQty(productId, delta) {
  const item = cart.find(i => i.productId === productId);
  if (!item) return;
  item.qty += delta;
  if (item.qty <= 0) removeFromCart(productId);
  else updateCartUI();
}

function renderCartBody() {
  const body        = document.getElementById('cart-body');
  const summary     = document.getElementById('cart-summary');
  const checkoutBtn = document.getElementById('btn-checkout');
  if (!body) return;

  if (cart.length === 0) {
    body.innerHTML = `<div class="cart-empty"><div class="cart-empty-icon">🛍️</div><p>${T('cart_empty')}</p></div>`;
    if (summary) summary.style.display = 'none';
    if (checkoutBtn) checkoutBtn.disabled = true;
    return;
  }

  body.innerHTML = cart.map(item => {
    const p = products[item.productId];
    return `<div class="cart-item-row">
      <div class="cart-item-img">${p.emoji}</div>
      <div class="cart-item-info">
        <div class="cart-item-name">${p.name}</div>
        <div class="cart-item-meta">${p.layout} · Hall Effect</div>
      </div>
      <div class="cart-item-right">
        <div class="qty-control">
          <button class="qty-btn" onclick="changeQty(${p.id},-1)">−</button>
          <span class="qty-num">${item.qty}</span>
          <button class="qty-btn" onclick="changeQty(${p.id},1)">+</button>
        </div>
        <div class="cart-item-price">NT$${(p.price*item.qty).toLocaleString()}</div>
        <button class="remove-item" onclick="removeFromCart(${p.id})">✕</button>
      </div>
    </div>`;
  }).join('');

  const subtotal = cart.reduce((s,i) => s + products[i.productId].price * i.qty, 0);
  document.getElementById('cart-subtotal').textContent     = `NT$${subtotal.toLocaleString()}`;
  document.getElementById('cart-total-display').textContent = `NT$${subtotal.toLocaleString()}`;
  if (summary)     summary.style.display = 'block';
  if (checkoutBtn) checkoutBtn.disabled  = false;
}

function updateCartUI() {
  const total = cart.reduce((s,i) => s + i.qty, 0);
  document.getElementById('cart-count').textContent = total;
  renderCartBody();
}

function toggleCart() {
  document.getElementById('cart-overlay').classList.toggle('open');
  document.getElementById('cart-drawer').classList.toggle('open');
}

/* =========================================================
   CHECKOUT
   ========================================================= */
let currentPayType = 'card';

function goCheckout() {
  document.getElementById('cart-overlay').classList.remove('open');
  document.getElementById('cart-drawer').classList.remove('open');

  const subtotal = cart.reduce((s,i) => s + products[i.productId].price * i.qty, 0);
  document.getElementById('order-items').innerHTML = cart.map(item => {
    const p = products[item.productId];
    return `<div class="order-item-row">
      <div class="order-item-emoji">${p.emoji}</div>
      <div class="order-item-info">
        <div class="order-item-name">${p.name}</div>
        <div class="order-item-qty">${T('qty_prefix')}${item.qty}</div>
      </div>
      <div class="order-item-price">NT$${(p.price*item.qty).toLocaleString()}</div>
    </div>`;
  }).join('');
  document.getElementById('order-subtotal').textContent = `NT$${subtotal.toLocaleString()}`;
  document.getElementById('order-grand').textContent    = `NT$${subtotal.toLocaleString()}`;

  // Apply language to checkout page static elements
  document.querySelectorAll('#page-checkout [data-t]').forEach(el => {
    el.innerHTML = T(el.getAttribute('data-t'));
  });
  document.querySelectorAll('#page-checkout [data-ph]').forEach(el => {
    el.placeholder = T(el.getAttribute('data-ph'));
  });

  currentPayType = 'card';
  renderPaymentFields('card');
  showPage('checkout');
}

function renderPaymentFields(type) {
  const fields = document.getElementById('payment-fields');
  if (!fields) return;
  if (type === 'card') {
    fields.innerHTML = `
      <div class="form-row full"><div class="form-group card-number-wrap">
        <label>${T('card_num')}</label>
        <input type="text" placeholder="1234 5678 9012 3456" maxlength="19" oninput="formatCard(this)">
        <span class="card-brand" id="card-brand">💳</span>
      </div></div>
      <div class="form-row">
        <div class="form-group"><label>${T('expiry')}</label><input type="text" placeholder="MM / YY" maxlength="7" oninput="formatExp(this)"></div>
        <div class="form-group"><label>${T('cvv')}</label><input type="text" placeholder="123" maxlength="3"></div>
      </div>
      <div class="form-row full"><div class="form-group">
        <label>${T('cardholder')}</label>
        <input type="text" placeholder="WANG XIAO MING">
      </div></div>`;
  } else if (type === 'transfer') {
    fields.innerHTML = `<div style="padding:20px;background:var(--bg);border-radius:12px;border:1px solid var(--border);color:var(--muted);font-size:0.9rem;line-height:1.9">
      ${T('bank_info')}</div>`;
  } else {
    fields.innerHTML = `<div style="text-align:center;padding:30px">
      <div style="font-size:3rem;margin-bottom:16px">📱</div>
      <p style="color:var(--muted)">${T('linepay_info')}</p>
    </div>`;
  }
}

function selectPayTab(el, type) {
  document.querySelectorAll('.pay-tab').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
  currentPayType = type;
  renderPaymentFields(type);
}

function formatCard(input) {
  let v = input.value.replace(/\D/g,'').substring(0,16);
  input.value = v.replace(/(.{4})/g,'$1 ').trim();
  const brand = document.getElementById('card-brand');
  if (brand) brand.textContent = v.startsWith('4')?'💙':v.startsWith('5')?'🔴':v.startsWith('3')?'💚':'💳';
}
function formatExp(input) {
  let v = input.value.replace(/\D/g,'');
  if (v.length >= 2) v = v.substring(0,2) + ' / ' + v.substring(2,4);
  input.value = v;
}

function placeOrder() {
  const orderNum = 'VTW-' + Math.random().toString(36).substring(2,8).toUpperCase();
  document.getElementById('success-order-num').textContent = T('order_prefix') + orderNum;
  // Translate success page
  document.querySelectorAll('#page-success [data-t]').forEach(el => {
    el.innerHTML = T(el.getAttribute('data-t'));
  });
  cart = [];
  updateCartUI();
  showPage('success');
}

/* =========================================================
   TOAST
   ========================================================= */
function showToast(msg) {
  const toast = document.getElementById('toast');
  document.getElementById('toast-msg').textContent = msg;
  toast.classList.add('show');
  setTimeout(() => toast.classList.remove('show'), 2800);
}

/* =========================================================
   INIT
   ========================================================= */
applyLang();
resetTimer();
renderCartBody(); // empty state
</script>
